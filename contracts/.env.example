# Copy to .env. NEVER commit .env.
# Deployer / owner private key. Only needed for --network robinhood.
DEPLOYER_PK=

# Voucher signer ADDRESS (the matching private key lives only in the Vercel env as SIGNER_PK).
SIGNER_ADDRESS=

# Optional — both default to the deployer address.
PAYOUT=
OPERATOR=

# Metadata endpoints
BASE_URI=https://example.vercel.app/api/metadata/
CONTRACT_URI=https://example.vercel.app/api/contract
